#!/usr/bin/env bash

# Back up configs, application lists and selected fonts into the chezmoi source.
#
# Written for macOS's stock bash 3.2 (no associative arrays, no ${var,,}).

set -uo pipefail

CHEZMOI_SOURCE="${CHEZMOI_SOURCE:-$HOME/.local/share/chezmoi/chezmoi}"
HOMEBREW_DIR="$CHEZMOI_SOURCE/dot_application-config/homebrew"
MANUAL_APPS_FILE="${MANUAL_APPS_FILE:-$CHEZMOI_SOURCE/dot_application-config/manual_apps.yml}"

# Font families to back up (substring match against file names in ~/Library/Fonts)
FONT_NAMES=(
  "LINESeed"
  "Chonburi"
  "CooperBlack"
  "LEMONMILK"
  "Notedry"
  "High Empathy"
  "Playful Boxes"
  "Super Kindly"
)

# Apps to ignore when detecting manual installs (bundled with other apps)
IGNORE_APPS=(
  "Google Docs"
  "Google Sheets"
  "Google Slides"
  "logioptionsplus"
)

# - - - - - - - - - - - - #
#  Helpers                #
# - - - - - - - - - - - - #

to_lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Read a command's output lines into the named array (bash 3.2 has no mapfile).
read_lines_into() {
  local __name="$1" __line
  shift
  eval "$__name=()"
  while IFS= read -r __line; do
    [[ -n "$__line" ]] || continue
    eval "$__name+=(\"\$__line\")"
  done < <("$@")
}

join_by() {
  local sep="$1" out="" item
  shift
  for item in "$@"; do
    out="${out:+$out$sep}$item"
  done
  printf '%s' "$out"
}

# Print the first FONT_NAMES pattern contained in $1, or fail.
find_matching_pattern() {
  local pattern
  for pattern in "${FONT_NAMES[@]}"; do
    if [[ "$1" == *"$pattern"* ]]; then
      printf '%s' "$pattern"
      return 0
    fi
  done
  return 1
}

is_font_managed_by_chezmoi() {
  local source_path
  source_path="$(chezmoi source-path "$1" 2>/dev/null)" || return 1
  [[ -f "$source_path" ]]
}

# display_font_group <title> <color> <font>...
display_font_group() {
  local title="$1" color="$2" pattern font
  shift 2
  (( $# > 0 )) || return 0

  echo "$title"
  for pattern in "${FONT_NAMES[@]}"; do
    local pattern_fonts=()
    for font in "$@"; do
      [[ "$font" == *"$pattern"* ]] && pattern_fonts+=("$font")
    done
    if (( ${#pattern_fonts[@]} > 0 )); then
      echo -e "\033[1;33m${pattern}*\033[0m"
      echo -e "${color}$(join_by ", " "${pattern_fonts[@]}")\033[0m"
      echo
    fi
  done
}

validate_claude_settings() {
  local settings_file="$HOME/.claude/settings.json"
  [[ -f "$settings_file" ]] || return 0

  # 'env' must stay an empty object
  if grep -q '"env"[[:space:]]*:[[:space:]]*{[[:space:]]*"[^"]*"' "$settings_file"; then
    echo "⚠️  WARNING: ~/.claude/settings.json contains sensitive data in 'env' field"
    echo "   This should NOT be backed up to git."
    echo "   Please clear the 'env' field before backing up, or add to .gitignore"
    return 1
  fi

  if grep -qiE '(api[_-]?key|password|token|secret|credential)' "$settings_file"; then
    echo "⚠️  WARNING: ~/.claude/settings.json may contain credentials"
    echo "   Please review before backing up"
    return 1
  fi

  return 0
}

# Lowercase, drop spaces and hyphens, drop a trailing "app"/"desktop".
normalize_app_name() {
  local name
  name="$(to_lower "$1")"
  name="${name// /}"
  name="${name//-/}"
  name="${name%app}"
  [[ "$name" == *desktop ]] && name="${name%desktop}"
  printf '%s' "$name"
}

# Print "url|notes" for an app already listed in manual_apps.yml.
get_existing_app_data() {
  local app_name="$1" file="$2"
  [[ -f "$file" ]] || { echo "|"; return 1; }
  awk -v needle="name: \"$app_name\"" '
    index($0, needle) { in_app = 1; url = ""; next }
    in_app && /^[[:space:]]+- name:/ { exit }
    in_app && /url:/ {
      url = $0; sub(/.*url:[[:space:]]*"/, "", url); sub(/".*/, "", url)
    }
    in_app && /notes:/ {
      notes = $0; sub(/.*notes:[[:space:]]*"/, "", notes); sub(/".*/, "", notes)
      print url "|" notes; found = 1; exit
    }
    END { if (!found) print "|" }
  ' "$file"
}

# - - - - - - - - - - - - #
#  Backup steps           #
# - - - - - - - - - - - - #

backup_configs() {
  echo "Backing up mise, starship & Claude settings"
  chezmoi add "$HOME/.config/mise/"
  chezmoi add "$HOME/.config/starship.toml"

  if validate_claude_settings; then
    chezmoi add "$HOME/.claude/settings.json"
  else
    echo "Skipped ~/.claude/settings.json due to validation warnings"
    return 1
  fi
}

backup_applications_config() {
  echo "Backing up application configs"
  chezmoi add "$HOME/.application-config/"
}

backup_homebrew() {
  echo "Backing up Homebrew (formula, casks, mas)"
  brew leaves > "$HOMEBREW_DIR/brew-formula.txt"
  brew list --cask > "$HOMEBREW_DIR/brew-casks.txt"
  mas list > "$HOMEBREW_DIR/mas-list.txt"
}

backup_manual_apps() {
  echo "Detecting manually installed apps..."

  local temp_file
  temp_file="$(mktemp)" || { echo "Error: Failed to create temporary file"; return 1; }
  chmod 600 "$temp_file"

  local cask_apps=() mas_apps=()
  read_lines_into cask_apps brew list --cask
  read_lines_into mas_apps sh -c "mas list 2>/dev/null | awk '{\$1=\"\"; print \$0}' | sed -e 's/^ *//' -e 's/ *(.*//' -e 's/\\.app\$//'"

  {
    echo "# Manual Applications (not installed via Homebrew or Mac App Store)"
    echo "# Fill in the 'url' field for each app to enable automated opening in browser"
    echo ""
    echo "apps:"
  } > "$temp_file"

  local manual_count=0 first_app=true
  local app_path app_name normalized_app is_manual ignore_app cask mas_app normalized existing url notes

  for app_path in /Applications/*.app; do
    [[ -d "$app_path" ]] || continue

    app_name="$(basename "$app_path" .app)"
    normalized_app="$(normalize_app_name "$app_name")"
    is_manual=true

    for ignore_app in "${IGNORE_APPS[@]}"; do
      if [[ "$app_name" == "$ignore_app" ]]; then
        is_manual=false
        break
      fi
    done

    if $is_manual; then
      for cask in ${cask_apps[@]+"${cask_apps[@]}"}; do
        normalized="$(normalize_app_name "$cask")"
        if [[ "$normalized_app" == *"$normalized"* || "$normalized" == *"$normalized_app"* ]]; then
          is_manual=false
          break
        fi
      done
    fi

    if $is_manual; then
      for mas_app in ${mas_apps[@]+"${mas_apps[@]}"}; do
        normalized="$(normalize_app_name "$mas_app")"
        if [[ "$normalized_app" == *"$normalized"* || "$normalized" == *"$normalized_app"* ]]; then
          is_manual=false
          break
        fi
      done
    fi

    $is_manual || continue
    manual_count=$((manual_count + 1))

    $first_app || echo "" >> "$temp_file"
    first_app=false

    existing="$(get_existing_app_data "$app_name" "$MANUAL_APPS_FILE")"
    url="${existing%%|*}"
    notes="${existing#*|}"

    echo "  - name: \"$app_name\"" >> "$temp_file"
    if [[ -n "$url" ]]; then
      echo "    url: \"$url\"" >> "$temp_file"
    else
      echo "    url: \"\"  # Fill in download URL" >> "$temp_file"
    fi
    echo "    notes: \"$notes\"" >> "$temp_file"
  done

  mv -f "$temp_file" "$MANUAL_APPS_FILE"

  echo "Found $manual_count manually installed apps"
  echo "Saved to: $MANUAL_APPS_FILE"
  echo
}

process_fonts() {
  echo "Backing up fonts..."
  echo

  local managed_fonts=() added_fonts=() font_file font_basename
  for font_file in "$HOME"/Library/Fonts/*; do
    [[ -f "$font_file" ]] || continue
    font_basename="$(basename "$font_file")"
    find_matching_pattern "$font_basename" >/dev/null || continue

    if is_font_managed_by_chezmoi "$font_file"; then
      managed_fonts+=("$font_basename")
    else
      chezmoi add "$font_file"
      added_fonts+=("$font_basename")
    fi
  done

  display_font_group "Fonts already managed by chezmoi:" "\033[34m" ${managed_fonts[@]+"${managed_fonts[@]}"}
  display_font_group "Added fonts:" "\033[32m" ${added_fonts[@]+"${added_fonts[@]}"}

  check_missing_patterns
}

check_missing_patterns() {
  local pattern font_file found
  for pattern in "${FONT_NAMES[@]}"; do
    found=false
    for font_file in "$HOME"/Library/Fonts/*; do
      if [[ -f "$font_file" && "$(basename "$font_file")" == *"$pattern"* ]]; then
        found=true
        break
      fi
    done
    $found || echo -e "No fonts found matching pattern: \033[31m${pattern}\033[0m"
  done
}

main() {
  echo "Starting backup process..."

  # Each step reports its own failure; keep going like the original script.
  backup_configs || true
  backup_applications_config || true
  backup_homebrew || true
  backup_manual_apps || true
  process_fonts

  echo "Backup completed!"
}

# Allow `source bin/backup` to load the functions without running a backup.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
